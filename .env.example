# API
VITE_API_BASE_URL=https://3w7s95cy97.execute-api.eu-west-2.amazonaws.com/prod
VITE_WS_URL=wss://f4o048p9c7.execute-api.eu-west-2.amazonaws.com/prod

# Firebase (client SDK — public config from Project settings → Your apps)
# Also enable Google as a sign-in provider in Firebase Console → Authentication.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Meta Ads (Events Manager → Data sources → Pixel). Leave blank to disable tracking.
# Also set these in the Netlify build environment so production receives events.
# Optimise ads on Purchase / Subscribe; use CompleteRegistration and InitiateCheckout
# as mid-funnel events. Pixel events are no-ops until this ID is set.
VITE_META_PIXEL_ID=
# Optional. Events Manager → Settings → Domain verification.
VITE_META_DOMAIN_VERIFICATION=

# Google Analytics 4 measurement ID (Admin → Data streams). Leave blank to disable.
VITE_GA_MEASUREMENT_ID=
